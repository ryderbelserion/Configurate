-                return ops.getStringValue(input)
-                    .flatMap(key -> {
-                        final V value = this.items.get(key);
-                        return value == null ? DataResult.error("No value for key " + key) : DataResult.success(value);
-                    }).map(val -> Pair.of(val, ops.empty()));
